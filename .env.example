# Optional. `docker compose up` works without copying this file.
# Values below are the Compose defaults. None of them are secrets.

# Host directory mounted read-only at /models in the API container.
# It must contain phase6-v1/ and phase7-v1/ from the local training run.
# ROADRISK_MODELS_DIR=./data/models

# Address written into the dashboard when the web container starts.
# /api is same-origin: the browser calls the frontend, which proxies to the API.
# A full URL such as http://127.0.0.1:8000 is build-independent but needs CORS.
# ROADRISK_PUBLIC_API_BASE_URL=/api

# The API container sets ROADRISK_DATABASE_URL to the history volume:
# sqlite:////var/lib/roadrisk/roadrisk.sqlite3
# Point that variable at a PostgreSQL SQLAlchemy URL to use another database.
# This stack does not start PostgreSQL.
